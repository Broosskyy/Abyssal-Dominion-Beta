config_version=5

[application]
config/name="Abyssal Dominion M3059"
config/version="0.305.9-test.1"
config/icon="res://assets/app_icon.svg"
boot_splash/show_image=false
run/main_scene="res://updater/launcher.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]
DataBoot="*res://updater/data_boot.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4
window/energy_saving/keep_screen_on=true

[input_devices]
pointing/emulate_mouse_from_touch=true

[rendering]
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.015, 0.09, 0.14, 1)

[debug]
gdscript/warnings/inference_on_variant=0
gdscript/warnings/inferred_declaration=0
